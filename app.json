{
  "expo": {
    "name": "EduQuiz",
    "slug": "eduquiz",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "eduquiz",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#683ad1"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.eduquiz.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#683ad1"
      },
      "package": "com.eduquiz.app"
    },
    "plugins": [
      "expo-router",
      "expo-font"
    ]
  }
}
